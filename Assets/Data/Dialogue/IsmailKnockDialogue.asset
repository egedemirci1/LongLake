  m_Script: {fileID: 11500000, guid: a11b22c33d44e55f66778899aabbcc01, type: 3}
  m_Name: IsmailKnockDialogue
  sequenceId: ismail_knock
  startNodeId: n1
  nodes:
  - id: n1
    speaker: "\u0130smail"
    text: "Buyurun?"
    voiceClip: {fileID: 0}
    choices:
    - label: "Kusura bakmay\u0131n. \u0130leride kaza yapt\u0131k; telefon da \u00E7ekmiyor."
      nextNodeId: n2
    - label: "Yolda kald\u0131k. Yard\u0131m isteyebilece\u011Fimiz birini ar\u0131yorduk."
      nextNodeId: n2
    nextNodeId: 
  - id: n2
    speaker: "\u0130smail"
    text: "Ge\u00E7mi\u015F olsun. \u0130yi misiniz? Yaralanan var m\u0131?"
    voiceClip: {fileID: 0}
    choices:
    - label: "\u0130yiyiz, sadece biraz sars\u0131ld\u0131k."
      nextNodeId: n3_ok
    - label: "Ciddi bir \u015Fey yok ama ara\u00E7 k\u00F6t\u00FC durumda."
      nextNodeId: n3_car
    nextNodeId: 
  - id: n3_ok
    speaker: "\u0130smail"
    text: "\u0130yi olman\u0131za sevindim. Az \u00F6nce sert bir ses duydum; demek sizdiniz."
    voiceClip: {fileID: 0}
    choices: []
    nextNodeId: n4
  - id: n3_car
    speaker: "\u0130smail"
    text: "\u00D6nce sizin iyi olman\u0131z \u00F6nemli. Az \u00F6nce sert bir ses duydum; demek sizdiniz."
    voiceClip: {fileID: 0}
    choices: []
    nextNodeId: n4
  - id: n4
    speaker: "\u0130smail"
    text: "Ara\u00E7 nerede kald\u0131?"
    voiceClip: {fileID: 0}
    choices:
    - label: "Viraj\u0131n a\u015Fa\u011F\u0131s\u0131nda, yolun kenar\u0131nda."
      nextNodeId: n5
    - label: "\u00C7ok uzakta de\u011Fil. \u0130sterseniz g\u00F6sterebiliriz."
      nextNodeId: n5
    nextNodeId: 
  - id: n5
    speaker: "\u0130smail"
    text: "Tamam. Bu ya\u011Fmurda burada beklemeyin. Fenerimi al\u0131p sizinle geleyim."
    voiceClip: {fileID: 0}
    choices: []
    nextNodeId: n6
  - id: n6
    speaker: "\u0130smail"
    text: "Hadi, arabaya bir bakal\u0131m."
    voiceClip: {fileID: 0}
    choices: []
    nextNodeId: 
